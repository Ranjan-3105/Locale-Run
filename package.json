{
  "name": "locale-run",
  "displayName": "Locale-Run",
  "description": "CodeRunner Extension for cross-device testing with QR code",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "localerunner.start",
        "title": "Locale-Run: Start Project",
        "icon": "$(play)"
      },
      {
        "command": "localerunner.stop",
        "title": "Locale-Run: Stop Dev Server"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "localerunner.start",
          "group": "navigation",
          "when": "true"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/node": "18.x",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^6.4.1",
    "@typescript-eslint/parser": "^6.4.1",
    "eslint": "^8.47.0",
    "typescript": "^5.1.6"
  },
  "dependencies": {
    "qrcode-terminal": "^0.12.0"
  }
}
