{
  "name": "locale-run",
  "displayName": "Locale-Run",
  "description": "CodeRunner Extension for cross-device testing with QR code",
  "publisher": "IamSRN",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.80.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Ranjan-3105/Locale-Run.git"
  },
  "categories": [
    "Other"
  ],
  "icon": "logo.png",
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "localerunner.start",
        "title": "Locale-Run: Start Project",
        "icon": "$(play)"
      },
      {
        "command": "localerunner.stop",
        "title": "Locale-Run: Stop Dev Server"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "localerunner.start",
          "group": "navigation",
          "when": "true"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run esbuild-base -- --minify",
    "esbuild-base": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "esbuild": "npm run esbuild-base -- --sourcemap",
    "esbuild-watch": "npm run esbuild-base -- --sourcemap --watch",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/node": "18.x",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^6.4.1",
    "@typescript-eslint/parser": "^6.4.1",
    "esbuild": "^0.28.1",
    "eslint": "^8.47.0",
    "typescript": "^5.1.6"
  },
  "dependencies": {
    "qrcode-terminal": "^0.12.0"
  }
}
